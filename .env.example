# Supabase
# Get these from: https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://dummy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dummy-key
# Server-only. Only needed for privileged server-side Supabase access.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase direct connection string (for Drizzle migrations, NOT the pooler)
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ─── AI Provider Selection ────────────────────────────────────────────────────
# TUGOBO_AI_PROVIDER controls which AI backend is used for server-side inference.
# Values: mock | openai | deepseek | claude | gemini
# Use "mock" for local development without real API keys — safe, deterministic.
# When unset, defaults to "openai" (requires OPENAI_API_KEY to be set).
TUGOBO_AI_PROVIDER=mock

# Legacy alias — still supported as fallback; prefer TUGOBO_AI_PROVIDER above.
# AI_PROVIDER=openai

# OpenAI
# Server-only. Never use NEXT_PUBLIC_ for API keys.
OPENAI_API_KEY=sk-...
# Optional model override (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# DeepSeek (web intelligence layer)
# Server-only. Never use NEXT_PUBLIC_ for API keys.
DEEPSEEK_API_KEY=
# Optional model override (default: deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat
# Optional base URL override (default: https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic / Claude
# Server-only. Never use NEXT_PUBLIC_ for API keys.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini
# Server-only. Never use NEXT_PUBLIC_ for API keys.
GEMINI_API_KEY=
# Optional model override (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=+14155238886

# Meta WhatsApp Cloud API
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=

# Inngest
# Leave empty for local dev if Inngest Dev Server is handling events.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Resend
# Form bildirimleri için kullanılır. Boş bırakılırsa e-posta gönderimi atlanır.
RESEND_API_KEY=re_...
NOTIFICATION_EMAIL=team@tugobo.ai

# WhatsApp direct link shown in success states
NEXT_PUBLIC_WHATSAPP_CONTACT=https://wa.me/905000000000

# Sprint 23: Live operations (pilot hotel)
# UUID of the pilot hotel row in `hotels` table (server + client realtime)
PILOT_HOTEL_ID=
NEXT_PUBLIC_PILOT_HOTEL_ID=

# Public application URL used for Twilio webhook signature validation
# Production: https://app.tugobo.com
# Development: https://abc123.ngrok-free.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Manychat bridge defaults
# Server-only. Leave empty for local development; demo-hotel/test-secret still works.
MANYCHAT_BRIDGE_OUTBOUND_URL=
MANYCHAT_BRIDGE_TOKEN=
MANYCHAT_BRIDGE_SECRET=
MANYCHAT_OUTBOUND_INTERNAL_TOKEN=
# Optional: force mock delivery even when bridge credentials are present.
MANYCHAT_OUTBOUND_MOCK_MODE=

# Legacy Manychat outbound names are still read as fallback.
MANYCHAT_OUTBOUND_API_URL=
MANYCHAT_OUTBOUND_API_TOKEN=
