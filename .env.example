# =============================================================================
# TUGOBO AI — Environment Configuration
# =============================================================================
# In production (NODE_ENV=production) the app FAILS FAST at startup if any
# MANDATORY variable below is missing/invalid (see packages/shared/src/env.ts
# assertProductionEnv() + apps/web/instrumentation.ts). In development, missing
# vars only produce warnings so local work stays flexible.
#
# Rule: only NEXT_PUBLIC_* vars are exposed to the browser. Never put an API key
# or secret behind a NEXT_PUBLIC_ name.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# MANDATORY IN PRODUCTION
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (public — safe for the browser)
# Get these from: https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://dummy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dummy-key

# Supabase Postgres connection string (server-only secret).
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Public application URL. MUST be the real domain in production (must NOT be
# localhost / 127.0.0.1). Used for absolute URLs and Twilio webhook signature.
# Production:  https://app.tugobo.com
# Development: http://localhost:3000  (or an ngrok URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI provider selection. Authoritative variable for server-side inference.
# Values: mock | openai | deepseek | claude | gemini
#   - "mock" is DEV-ONLY (deterministic, no API key). REJECTED in production.
#   - In production the provider-specific key below MUST be set.
TUGOBO_AI_PROVIDER=mock

# Pilot hotel (live operations). Server + client (realtime) copies must match.
# UUID of the pilot hotel row in the `hotels` table.
PILOT_HOTEL_ID=
NEXT_PUBLIC_PILOT_HOTEL_ID=


# ─────────────────────────────────────────────────────────────────────────────
# AI PROVIDER KEYS  (the one matching TUGOBO_AI_PROVIDER is MANDATORY in prod)
# All API keys are server-only — never prefix with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI (required if TUGOBO_AI_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# DeepSeek (required if TUGOBO_AI_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional base URL override (default: https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic / Claude (required if TUGOBO_AI_PROVIDER=claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini (required if TUGOBO_AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Legacy alias — still read as a fallback when TUGOBO_AI_PROVIDER is unset.
# AI_PROVIDER=openai


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL / FUTURE  (enable per integration; not required to boot production)
# ─────────────────────────────────────────────────────────────────────────────

# Supabase privileged server access (server-only). Only if used.
SUPABASE_SERVICE_ROLE_KEY=

# Twilio WhatsApp (server-only secret: TWILIO_AUTH_TOKEN)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=+14155238886

# Meta WhatsApp Cloud API (server-only secret: META_WHATSAPP_TOKEN)
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=

# Inngest (server-only)
# Leave empty for local dev if the Inngest Dev Server handles events.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Langfuse (server-only secret: LANGFUSE_SECRET_KEY)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Resend (transactional email; server-only). Empty = email sending skipped.
RESEND_API_KEY=re_...
NOTIFICATION_EMAIL=team@tugobo.ai

# WhatsApp direct link shown in success states (public)
NEXT_PUBLIC_WHATSAPP_CONTACT=https://wa.me/905000000000

# ManyChat bridge (server-only). Leave empty for local dev; the demo-hotel /
# test-secret mock path only works when NODE_ENV != production.
MANYCHAT_BRIDGE_OUTBOUND_URL=
MANYCHAT_BRIDGE_TOKEN=
MANYCHAT_BRIDGE_SECRET=
MANYCHAT_OUTBOUND_INTERNAL_TOKEN=
# Optional: force mock delivery even when bridge credentials are present.
MANYCHAT_OUTBOUND_MOCK_MODE=
# Legacy ManyChat outbound names are still read as a fallback.
MANYCHAT_OUTBOUND_API_URL=
MANYCHAT_OUTBOUND_API_TOKEN=
